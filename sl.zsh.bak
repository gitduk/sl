#!/usr/bin/env zsh
show_help() {
  cat <<EOF
Usage: sl [-r] [-d] <pattern> [<pattern> ...]
       sl -k [<host> ...]

SSH port forwarding wrapper with simplified syntax.
Multiple hosts spawn parallel SSH sessions; Ctrl-C tears all down.

Patterns:
  <host>:<port>[,<port>...]    Same port on both sides
  <port1>:<host>:<port2>       Entry port -> target port
                               local: :port1 here -> host:port2
                               -r:    host:port1 -> :port2 here

Options:
  -r    Remote forwarding (default: local)
  -d    Detach after connecting, return to the prompt at once
  -k    Stop detached sessions started with -d (all, or those touching <host>)
  -h    Show this help message

Local forwards listen on 127.0.0.1 only; remote forwards listen on the far end's
loopback. Host names may not contain ':' (no IPv6 literals).

Examples:
  sl wk:8000                     # Local forward: localhost:8000 -> wk:8000
  sl wk:4000,4001,4002           # Local forward: ports 4000, 4001, 4002 on wk
  sl 8001:wk:8000                # Local forward: localhost:8001 -> wk:8000
  sl -r wk:8000                  # Remote forward: wk:8000 -> localhost:8000
  sl -r 5056:wk:8080             # Remote forward: wk:5056 -> localhost:8080
  sl -d wk:4000,9200             # Detached; stop later with: sl -k wk
  sl -k                          # Stop every detached session
  sl wk:4000,9200 8008:ds:8000   # Two hosts: parallel SSH sessions
EOF
}

build_forward_flag() {
  local mode="$1" bind_addr="$2" entry_port="$3" target_port="$4"
  if [[ "$mode" == "-NL" ]]; then
    printf -- "-L %s%s:localhost:%s" "$bind_addr" "$entry_port" "$target_port"
  else
    printf -- "-R %s%s:localhost:%s" "$bind_addr" "$entry_port" "$target_port"
  fi
}

print_mapping() {
  local mode="$1" host="$2" entry_port="$3" target_port="$4" ok="${5:-1}"
  local mark color_a color_b
  if [[ "$ok" != 1 ]]; then
    mark="[x]"; color_a=31; color_b=31
  elif [[ "$mode" == "-NL" ]]; then
    mark="[L]"; color_a=32; color_b=34
  else
    mark="[R]"; color_a=34; color_b=32
  fi
  if [[ "$mode" == "-NL" ]]; then
    printf "\e[%sm%s\e[0m \e[%sm:%-6s\e[0m ⇒  \e[%sm%s:%-6s\e[0m\n" \
      "$color_a" "$mark" "$color_a" "$entry_port" "$color_b" "$host" "$target_port" >&2
  else
    printf "\e[%sm%s\e[0m \e[%sm%s:%-6s\e[0m ⇒  \e[%sm:%-6s\e[0m\n" \
      "$color_a" "$mark" "$color_a" "$host" "$entry_port" "$color_b" "$target_port" >&2
  fi
}

stop_detached() {
  local -a hosts=("$@")
  local dir ctl name pid found=0 match comm
  for dir in /tmp/sl.*(N/); do
    [[ -O "$dir" && -f "$dir/detached" ]] || continue
    if (( ${#hosts[@]} )); then
      match=0
      for ctl in "$dir"/*.ctl(N); do
        name="${ctl:t:r}"
        (( ${hosts[(I)$name]} )) && { match=1; break; }
      done
      (( match )) || continue
    fi
    found=1
    if [[ -f "$dir/supervisor.pid" ]]; then
      pid="$(<"$dir/supervisor.pid")"
      local comm=""
      [[ "$pid" =~ ^[0-9]+$ ]] && comm="$(ps -o comm= -p "$pid" 2>/dev/null)"
      comm="${comm// /}"
      if [[ "$comm" == zsh ]]; then
        kill -TERM "$pid" 2>/dev/null
        print -r -- "sl: stopping detached session $dir (pid $pid)" >&2
      fi
    fi
    for ctl in "$dir"/*.ctl(N); do
      name="${ctl:t:r}"
      ssh -S "$ctl" -O exit "$name" >/dev/null 2>&1
    done
    rm -rf "$dir"
  done
  if (( ! found )); then
    print -r -- "sl: no detached session${hosts[1]:+ matching ${(j:, :)hosts}}" >&2
    return 1
  fi
  return 0
}

main() {
  setopt local_options no_monitor
  local mode="-NL"
  local bind_addr="127.0.0.1:"
  local detach=0
  local -A host_flags     # host -> newline-joined forward flags
  local -a mapping_order  # host:entry_port:target_port in input order
  local -a host_order     # hosts in order of first appearance
  local -a ssh_opts=(
    -o ExitOnForwardFailure=yes
    -o WarnWeakCrypto=no
    -o ServerAliveInterval=15
    -o ServerAliveCountMax=3
  )

  while (( $# )); do
    case "$1" in
      -h|--help) show_help; return 0 ;;
      -r) mode="-NR"; bind_addr="" ;;
      -d|--detach) detach=1 ;;
      -k|--kill) shift; stop_detached "$@"; return $? ;;
      --) shift; break ;;
      -*) echo "Error: Unknown option '$1'" >&2; show_help; return 1 ;;
      *) break ;;
    esac
    shift
  done

  [[ $# -eq 0 ]] && { echo "Error: Missing argument" >&2; show_help; return 1; }

  local tmp_dir
  tmp_dir="$(mktemp -d -t sl.XXXXXX)" || return 1

  _sl_add() {
    local host="$1" entry_port="$2" target_port="$3" flag
    mapping_order+=("$host:$entry_port:$target_port")
    flag="$(build_forward_flag "$mode" "$bind_addr" "$entry_port" "$target_port")"
    if [[ -z "${host_flags[$host]+_}" ]]; then
      host_order+=("$host")
      host_flags[$host]="$flag"
    else
      host_flags[$host]+=$'\n'"$flag"
    fi
  }

  _sl_echo_stderr() {
    local err_file="$tmp_dir/$1.err"
    [[ -s "$err_file" ]] && cat -- "$err_file" >&2
    return 0
  }

  _sl_failed_entries() {
    local err_file="$tmp_dir/$1.err" line
    [[ -f "$err_file" ]] || return 0
    while IFS= read -r line; do
      if [[ "$line" =~ '^bind .+:([0-9]+): ' ]] ||
         [[ "$line" =~ 'forwarding failed for listen port ([0-9]+)' ]]; then
        print -r -- "${match[1]}"
      fi
    done < "$err_file"
  }

  _sl_print_host() {
    local host="$1" connected="$2" mapping entry_port target_port
    local -a failed=(${(f)"$(_sl_failed_entries "$host")"})
    for mapping in "${mapping_order[@]}"; do
      [[ "${mapping%%:*}" == "$host" ]] || continue
      entry_port="${mapping#*:}"; entry_port="${entry_port%%:*}"
      target_port="${mapping##*:}"
      if (( connected )) && [[ -z "${failed[(r)$entry_port]}" ]]; then
        print_mapping "$mode" "$host" "$entry_port" "$target_port" 1
      else
        print_mapping "$mode" "$host" "$entry_port" "$target_port" 0
      fi
    done
  }

  local arg port host
  for arg in "$@"; do
    if [[ "$arg" =~ ^([0-9]+):([^:,]+):([0-9]+)$ ]]; then
      _sl_add "${match[2]}" "${match[1]}" "${match[3]}"
    elif [[ "$arg" =~ ^([^:,]+):([0-9][0-9,]*)$ ]]; then
      host="${match[1]}"
      for port in ${(s:,:)${match[2]}}; do
        [[ "$port" =~ ^[0-9]+$ ]] || { echo "Error: Invalid port '$port' in '$arg'" >&2; return 1; }
        _sl_add "$host" "$port" "$port"
      done
    else
      echo "Error: Invalid pattern '$arg'" >&2
      show_help
      return 1
    fi
  done

  _sl_cleanup() {
    local h
    for h in "${host_order[@]}"; do
      ssh -S "$tmp_dir/$h.ctl" -O exit "$h" >/dev/null 2>&1
    done
    rm -rf "$tmp_dir"
    trap - EXIT INT TERM HUP
  }

  _sl_start() {
    local h
    local -a launch_pids=()
    for h in "${host_order[@]}"; do
      (
        local -a flags=(${(f)host_flags[$h]})
        ssh -M -S "$tmp_dir/$h.ctl" -f -N "${ssh_opts[@]}" "${flags[@]}" "$h" 2> "$tmp_dir/$h.err"
        print -r -- "$?" > "$tmp_dir/$h.status"
      ) &
      launch_pids+=($!)
    done
    wait "${launch_pids[@]}"
  }

  _sl_monitor() {
    local -A reported_down=()
    local h sock err_file
    while true; do
      for h in "${connected_hosts[@]}"; do
        sock="$tmp_dir/$h.ctl"
        ssh -S "$sock" -O check "$h" >/dev/null 2>&1 && continue
        err_file="$tmp_dir/$h.err"
        : > "$err_file"
        local -a flags=(${(f)host_flags[$h]})
        if ssh -M -S "$sock" -f -N "${ssh_opts[@]}" "${flags[@]}" "$h" 2> "$err_file"; then
          unset "reported_down[$h]"
          print -r -- "[~] $h: reconnected" >&2
          _sl_echo_stderr "$h"
          _sl_print_host "$h" 1
        elif (( ! ${+reported_down[$h]} )); then
          reported_down[$h]=1
          print -r -- "[~] $h: reconnect failed, retrying every 5s" >&2
          _sl_echo_stderr "$h"
          _sl_print_host "$h" 0
        fi
      done
      sleep 5
    done
  }

  trap '_sl_cleanup; exit 130' INT TERM HUP
  trap _sl_cleanup EXIT

  _sl_start
  local launch_status=0 ssh_status h
  local -a connected_hosts=()
  for h in "${host_order[@]}"; do
    ssh_status=1
    [[ -f "$tmp_dir/$h.status" ]] && ssh_status="$(<"$tmp_dir/$h.status")"
    if (( ssh_status == 0 )); then
      connected_hosts+=("$h")
    else
      launch_status=$ssh_status
    fi
  done

  for h in "${host_order[@]}"; do _sl_echo_stderr "$h"; done
  for h in "${host_order[@]}"; do
    if [[ -n "${connected_hosts[(r)$h]}" ]]; then
      _sl_print_host "$h" 1
    else
      _sl_print_host "$h" 0
    fi
  done

  if (( ${#connected_hosts[@]} == 0 )); then
    (( launch_status )) || launch_status=1
    _sl_cleanup
    exit $launch_status
  fi

  if (( detach )); then
    (
      trap '_sl_cleanup; exit 130' INT TERM HUP
      trap _sl_cleanup EXIT
      exec </dev/null
      _sl_monitor
    ) > "$tmp_dir/monitor.log" 2>&1 &!
    print -r -- "$!" > "$tmp_dir/supervisor.pid"
    : > "$tmp_dir/detached"
    trap - INT TERM HUP EXIT
    print -r -- "sl: running detached (supervisor $!), stop with: sl -k" >&2
    return 0
  fi

  _sl_monitor
}

main "$@"
